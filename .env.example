# ============================================================
# ZaPost — variáveis de ambiente
# Copie para .env e preencha. Nunca comite o .env.
# ============================================================

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3100

# ---- Banco e fila (rodam na VPS que já é paga) --------------
DATABASE_URL=postgresql://zapost:changeme@localhost:5432/zapost
REDIS_URL=redis://localhost:6379

# ---- Mídia: MinIO local. R2 só quando a banda doer ---------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=zapost-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=http://localhost:9000/zapost-media

# ---- IA -----------------------------------------------------
# Conteúdo e adaptação PT↔EN
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-5

# Transcrição de áudio (só no canal de conversa; no navegador usa Web Speech API)
OPENAI_API_KEY=

WHISPER_MODEL=whisper-1

# Tratamento de imagem — DESLIGADO por padrão.
# Só roda atrás do botão "✨ melhorar foto", que consome crédito extra.
IMAGE_AI_ENABLED=false
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=

# Teto de gasto mensal em USD. Estourou, cai para o provedor reserva.
AI_MONTHLY_BUDGET_USD=200

# ---- WhatsApp Cloud API (direto na Meta, sem intermediário) -
# Conversa iniciada pelo cliente na janela de 24h é gratuita.
# Mensagem iniciada pelo negócio é template PAGO — orçar antes de ligar.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Telegram (só ambiente de desenvolvimento) --------------
TELEGRAM_BOT_TOKEN=8959245359:AAFmHGhPoxq9UKTpaZO-onIt61BtE4o70aw


# ---- Cobrança ----------------------------------------------
STRIPE_SECRET_KEY=

STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# ---- Autenticação ------------------------------------------
# Google primeiro, SMS como alternativa.
# Nunca e-mail+senha como caminho principal: esse público perde a senha.
AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Medição -----------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Conversão disparada pelo SERVIDOR, no webhook do Stripe.
# Medição no navegador se perde com bloqueador de anúncio.
GA4_API_SECRET=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
