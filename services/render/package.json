{
  "name": "@zapost/render",
  "version": "0.0.1",
  "private": true,
  "description": "Motor de renderização ZaPost: Satori + resvg para gerar PNGs vendáveis a partir de briefs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zapost-render": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@zapost/contracts": "workspace:*",
    "@zapost/tokens": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satori": "^0.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0"
  }
}
