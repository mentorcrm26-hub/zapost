# Sem dependência fantasma: se o pacote não está no package.json dele, não importa.
# Isso é o que impede o worker de render de puxar algo pesado por acidente.
strict-peer-dependencies=false
auto-install-peers=true

# Uma cópia de cada pacote em disco, ligada por hard link nos projetos.
# Importante: a VPS tem 100 GB e roda mais de um projeto.
node-linker=isolated

# Salva a versão exata no package.json. Build reproduzível.
save-exact=true
